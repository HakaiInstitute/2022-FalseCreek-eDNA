mutate(across(everything(), ~ ifelse(grepl("^uncultured_|^unidentified_", .), NA, .)),
across(everything(), ~ ifelse(grepl("marine_metagenome|bacterium_enrichment|soda_lake|metagenome|hydrothermal_vent|seawater_metagenome", .), NA, .)))
